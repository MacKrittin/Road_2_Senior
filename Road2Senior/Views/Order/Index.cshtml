@Html.AntiForgeryToken()

<button onclick="confirmBtn()" class="btn-success">Confirm</button>

@section Scripts{
    <script>

        var urlConfirm = '@Url.Action("Confirm", "Order")';
        var urlSuccess = '@Url.Action("Success", "Order")';


        $(document).ready({

        });
        

        function confirmBtn(){

            // เอาบัตรไปให้ยาม
            const token = $('input[name="__RequestVerificationToken"]').val();

            $.ajax({
                url: urlConfirm,
                type: "POST",
                headers: {"RequestVerificationToken": token},
                data: {orderId: 1},
                success: function () {
                    
                    window.location.href = urlSuccess;

                },
                error: function (xhr, status, error) {
                    console.error("Confirm Failed:", xhr.status, error);

                }
            });
        }
        

    </script>
}