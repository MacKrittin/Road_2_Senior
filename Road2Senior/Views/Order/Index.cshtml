@Html.AntiForgeryToken()

<button onclick="confirmBtn()" class="btn-success">Confirm</button>

@section Scripts{
    <script>
        var urlConfirmRelative = "Order/Confirm"; // relative url
        var urlConfirm = '@Url.Action("Order","Confirm")';
        var urlSuccess = '@Url.Action("Order","Success")';


        $(document).ready({

        });
        

        function confirmBtn(){

            // เอาบัตรไปให้ยาม
            const token = $('input[name="__RequestVerificationToken"]');

            $.ajax({
                url: urlConfirm,
                type: "POST",
                header: {"RequestVerificationToken": token},
                data: {orderId: 1},
                success: function () {
                    
                    window.location.href(urlSuccess);

                },
                error: function (xhr, status, error) {
                    console.error("Confirm Failed:", xhr.status, error);

                }
            });
        }
        

    </script>
}